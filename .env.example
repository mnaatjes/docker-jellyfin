# ==============================================================================
# Jellyfin Media Server - Environment Configuration Template
# Copy this file to .env and configure local values during development.
# In production, this file is templated by Ansible orchestration (homelab-ops).
# ==============================================================================

# Application Environment (prod, stage, dev)
APP_ENV=prod

# User & Group Ownership for persistent files
JELLYFIN_UID=1000
JELLYFIN_GID=1000

# Timezone
TZ=America/New_York

# Published Web Client URL
JELLYFIN_PUBLISHED_URL=http://192.168.1.51:8096

# Base Persistent Runtime State (Mirrored under /opt/homelab/prod/data/docker-jellyfin)
DATA_DIR=/opt/homelab/prod/data/docker-jellyfin

# Base Media Directory Mount (NFS/SMB mount from prd-nas-01.lan)
MEDIA_DIR=/mnt/nas/media
